#!/usr/bin/env bash

# ANSI Color Palette
C_CYAN="\033[1;36m"
C_GREEN="\033[1;32m"
C_YELLOW="\033[1;33m"
C_RED="\033[1;31m"
C_MAGENTA="\033[1;35m"
C_GRAY="\033[0;90m"
C_RESET="\033[0m"

# Check dependencies
for cmd in fzf ffmpeg; do
    if ! command -v "$cmd" &>/dev/null; then
        echo -e "${C_RED}Error: Required dependency '$cmd' is not installed.${C_RESET}" >&2
        exit 1
    fi
done

# 1. Select files (CLI args or multi-select fzf filtered strictly to media formats)
if [ $# -gt 0 ]; then
    files=("$@")
else
    echo -e "${C_CYAN}Scanning directory for media files...${C_RESET}"
    mapfile -t files < <(
        find . -maxdepth 3 -type f \( \
            -iname "*.mp4" -o -iname "*.mkv" -o -iname "*.avi" -o -iname "*.mov" -o \
            -iname "*.webm" -o -iname "*.flv" -o -iname "*.wmv" -o -iname "*.m4v" -o \
            -iname "*.ts" -o -iname "*.m2ts" -o -iname "*.ogv" -o -iname "*.3gp" -o \
            -iname "*.f4v" -o -iname "*.divx" -o -iname "*.asf" -o -iname "*.rm" -o \
            -iname "*.mp3" -o -iname "*.flac" -o -iname "*.wav" -o -iname "*.ogg" -o \
            -iname "*.m4a" -o -iname "*.aac" -o -iname "*.wma" -o -iname "*.opus" -o \
            -iname "*.ape" -o -iname "*.alac" -o -iname "*.ac3" -o -iname "*.dts" -o \
            -iname "*.mka" -o -iname "*.aiff" -o -iname "*.shn" -o -iname "*.dsd" \
        \) ! -path '*/.*' 2>/dev/null | \
        fzf -m --prompt="Select Media > " \
            --header="[Media Filter Active] TAB to multi-select, ENTER to confirm" \
            --ansi
    )
fi

[[ ${#files[@]} -eq 0 ]] && echo -e "${C_YELLOW}No media files selected. Exiting.${C_RESET}" && exit 0

# 2. Choose Encoding Mode (Standard Custom Wizard vs. Mac OS 7.6 Vintage Presets)
mode_choice=$(printf "Standard Custom Encode Wizard\nMac OS 7.6 Preset (160x120 @ 10fps, RPZA)\nMac OS 7.6 Preset (240x180 @ 12fps, RPZA + Colr Atom)" | fzf --prompt="Select Encoding Mode > ")
[[ -z "$mode_choice" ]] && echo -e "${C_YELLOW}Cancelled.${C_RESET}" && exit 0

# Initialize parameter variables
container=""
vcodec_args=""
video_filter_arg=""
acodec_args=""
sample_rate_arg=""
channel_arg=""
subtitle_arg=""
extra_movflags=""

if [[ "$mode_choice" == *"Mac OS 7.6 Preset (160x120"* ]]; then
    container="mov"
    vcodec_args="-c:v rpza -pix_fmt rgb555le"
    video_filter_arg="-vf scale=160:120:flags=fast_bilinear,fps=10"
    acodec_args="-c:a pcm_s16be -ar 22050 -ac 1"
    subtitle_arg="-sn"
    extra_movflags="-movflags +faststart"

elif [[ "$mode_choice" == *"Mac OS 7.6 Preset (240x180"* ]]; then
    container="mov"
    vcodec_args="-c:v rpza -pix_fmt rgb555le -g 15 -fflags +bitexact -flags +global_header"
    video_filter_arg="-vf scale=240:180:flags=fast_bilinear,fps=12"
    acodec_args="-c:a pcm_s16be -ar 22050 -ac 1"
    subtitle_arg="-sn"
    extra_movflags="-movflags +write_colr+faststart"

else
    # Standard Custom Wizard Flow
    # 3. Choose Output Container / Format
    container=$(printf "mp4\nmkv\nwebm\nmov\navi\nflv\nmp3\nflac\nwav\nogg\nm4a" | fzf --prompt="Select Output Container > ")
    [[ -z "$container" ]] && echo -e "${C_YELLOW}Cancelled.${C_RESET}" && exit 0

    # 4. Choose Video Codec (skip if output is audio-only)
    if [[ "$container" =~ ^(mp3|flac|wav|ogg|m4a)$ ]]; then
        vcodec_args="-vn"
    else
        vcodec=$(printf "libx264 (H.264 - Universal)\nlibx265 (H.265 / HEVC)\nlibsvtav1 (AV1)\nlibvpx-vp9 (VP9)\ncopy (Stream Copy / No Re-encode)\nnone (Audio Only)" | fzf --prompt="Select Video Codec > ")
        [[ -z "$vcodec" ]] && echo -e "${C_YELLOW}Cancelled.${C_RESET}" && exit 0

        case "$vcodec" in
            libx264*|libx265*)
                codec_name=$(echo "$vcodec" | awk '{print $1}')
                
                # CRF Selection
                crf_choice=$(printf "Default / Balanced\nCustom CRF Value" | fzf --prompt="Select CRF Mode > ")
                if [[ "$crf_choice" == "Custom CRF Value" ]]; then
                    read -rp "Enter CRF number (e.g., 18, 23, 28): " custom_crf
                    crf_val="${custom_crf:-23}"
                else
                    crf_val=23
                    [[ "$codec_name" == "libx265" ]] && crf_val=28
                fi

                # Encoder Speed Preset Selection
                preset_choice=$(printf "medium (Default / Balanced)\nfast\nfaster\nveryfast\nsuperfast\nultrafast\nslow\nslower\nveryslow" | fzf --prompt="Select Encoder Speed Preset > ")
                selected_preset=$(echo "${preset_choice:-medium}" | awk '{print $1}')

                vcodec_args="-c:v $codec_name -crf $crf_val -preset $selected_preset"
                ;;
            libsvtav1*)
                read -rp "Enter AV1 CRF value (default 30): " av1_crf
                
                av1_preset_choice=$(printf "6 (Default / Balanced)\n4 (Higher Quality / Slower)\n8 (Faster)\nCustom Preset Number..." | fzf --prompt="Select SVT-AV1 Preset > ")
                if [[ "$av1_preset_choice" == "Custom Preset Number..." ]]; then
                    read -rp "Enter custom preset integer (0-13, default 6): " custom_av1_preset
                    av1_p="${custom_av1_preset:-6}"
                else
                    av1_p=$(echo "$av1_preset_choice" | awk '{print $1}')
                fi

                vcodec_args="-c:v libsvtav1 -crf ${av1_crf:-30} -preset ${av1_p:-6}"
                ;;
            libvpx-vp9*)
                read -rp "Enter VP9 CRF value (default 30): " vp9_crf
                vcodec_args="-c:v libvpx-vp9 -b:v 0 -crf ${vp9_crf:-30}"
                ;;
            "copy"*)
                vcodec_args="-c:v copy"
                ;;
            "none"*)
                vcodec_args="-vn"
                ;;
        esac
    fi

    # 5. Choose Video Resolution / Resizing & Deinterlacing (skipped if video is copied or omitted)
    if [[ "$vcodec_args" != "-vn" && "$vcodec_args" != "-c:v copy" ]]; then
        scale_val=""
        resize_choice=$(printf "Keep Original Resolution\nScale to 1080p (1920x1080)\nScale to 720p (1280x720)\nScale to 480p (854x480)\nScale to 360p (640x360)\nScale to 240p (426x240)\nCustom Resolution / Scale Filter..." | fzf --prompt="Select Resolution / Resize > ")
        case "$resize_choice" in
            "Scale to 1080p"*) scale_val="scale=-2:1080" ;;
            "Scale to 720p"*) scale_val="scale=-2:720" ;;
            "Scale to 480p"*) scale_val="scale=-2:480" ;;
            "Scale to 360p"*) scale_val="scale=-2:360" ;;
            "Scale to 240p"*) scale_val="scale=-2:240" ;;
            "Custom Resolution / Scale Filter...")
                read -rp "Enter FFmpeg scale filter or dimensions (e.g., -2:720, 1280:720): " custom_scale
                [[ -n "$custom_scale" ]] && scale_val="scale=$custom_scale"
                ;;
        esac

        deint_val=""
        deint_choice=$(printf "None (Progressive / Skip)\nYADIF (Standard - Fast)\nYADIF (Double Framerate / Smooth)\nBWDIF (High Quality Motion-Adaptive)\nCustom Deinterlace Filter..." | fzf --prompt="Select Deinterlace Filter > ")
        case "$deint_choice" in
            "YADIF (Standard"*) deint_val="yadif=0" ;;
            "YADIF (Double"*) deint_val="yadif=1" ;;
            "BWDIF"*) deint_val="bwdif=0" ;;
            "Custom Deinterlace Filter...")
                read -rp "Enter FFmpeg deinterlace filter expression: " custom_deint
                [[ -n "$custom_deint" ]] && deint_val="$custom_deint"
                ;;
        esac

        # Combine filters into a single -vf chain if needed
        if [[ -n "$deint_val" && -n "$scale_val" ]]; then
            video_filter_arg="-vf ${deint_val},${scale_val}"
        elif [[ -n "$deint_val" ]]; then
            video_filter_arg="-vf ${deint_val}"
        elif [[ -n "$scale_val" ]]; then
            video_filter_arg="-vf ${scale_val}"
        fi
    fi

    # 6. Choose Audio Codec
    acodec=$(printf "aac (MPEG-4 Audio)\nlibmp3lame (MP3)\nlibopus (Opus)\nflac (Lossless)\nac3 (Dolby Digital)\ncopy (Stream Copy / No Re-encode)\nnone (Video Only)" | fzf --prompt="Select Audio Codec > ")
    [[ -z "$acodec" ]] && echo -e "${C_YELLOW}Cancelled.${C_RESET}" && exit 0

    case "$acodec" in
        aac*|libmp3lame*|libopus*|ac3*)
            codec_name=$(echo "$acodec" | awk '{print $1}')
            
            bitrate_choice=$(printf "64k\n96k\n128k\n160k\n192k\n256k\n320k\nCustom Bitrate..." | fzf --prompt="Select Audio Bitrate > ")
            if [[ "$bitrate_choice" == "Custom Bitrate..." ]]; then
                read -rp "Enter custom bitrate (e.g., 112k, 224k, 500k): " custom_bitrate
                acodec_args="-c:a $codec_name -b:a ${custom_bitrate:-192k}"
            else
                acodec_args="-c:a $codec_name -b:a $bitrate_choice"
            fi
            ;;
        flac*)
            acodec_args="-c:a flac"
            ;;
        "copy"*)
            acodec_args="-c:a copy"
            ;;
        "none"*)
            acodec_args="-an"
            ;;
    esac

    # 7. Granular Audio Sample Rate with Custom Override
    if [[ "$acodec" != "none (Video Only)" && "$acodec" != "copy (Stream Copy / No Re-encode)" ]]; then
        srate_choice=$(printf "Keep Original\n8000 Hz\n11025 Hz\n16000 Hz\n22050 Hz\n32000 Hz\n44100 Hz (CD)\n48000 Hz (Video)\n96000 Hz (Hi-Res)\nCustom Sample Rate..." | fzf --prompt="Select Sample Rate > ")
        if [[ "$srate_choice" == "Custom Sample Rate..." ]]; then
            read -rp "Enter sample rate in Hz (e.g., 22050, 44100, 48000): " custom_srate
            [[ -n "$custom_srate" ]] && sample_rate_arg="-ar $custom_srate"
        elif [[ "$srate_choice" != "Keep Original" && -n "$srate_choice" ]]; then
            val=$(echo "$srate_choice" | awk '{print $1}')
            sample_rate_arg="-ar $val"
        fi
    fi

    # 8. Audio Channels & Stereo Modes
    if [[ "$acodec" != "none (Video Only)" && "$acodec" != "copy (Stream Copy / No Re-encode)" ]]; then
        chan_choice=$(printf "Keep Original\nMono (1 Channel)\nStereo (Joint Stereo / Standard)\nStereo (Forced Discrete / Normal)\n5.1 Surround (6 Channels)\nCustom Channel Layout / Count..." | fzf --prompt="Select Audio Channels & Mode > ")
        case "$chan_choice" in
            "Mono"*) 
                channel_arg="-ac 1" 
                ;;
            "Stereo (Joint Stereo"*) 
                channel_arg="-ac 2" 
                ;;
            "Stereo (Forced Discrete"*) 
                channel_arg="-ac 2 -stereo_mode forced" 
                ;;
            "5.1"*) 
                channel_arg="-ac 6" 
                ;;
            "Custom Channel Layout / Count...")
                read -rp "Enter FFmpeg channel layout or count (e.g., 1, 2, 5.1, quad, 7.1): " custom_chan
                [[ -n "$custom_chan" ]] && channel_arg="-ac $custom_chan"
                ;;
        esac
    fi

    # 9. Subtitle Handling Options
    sub_choice=$(printf "Strip All Subtitles (-sn / Recommended)\nKeep / Copy Subtitles (If container supports)" | fzf --prompt="Subtitle Handling > ")
    if [[ "$sub_choice" == *"Strip All Subtitles"* ]]; then
        subtitle_arg="-sn"
    fi
fi

# 10. Process all files safely with collision checks and vibrant feedback
echo -e "\n${C_MAGENTA}========================================${C_RESET}"
echo -e "${C_MAGENTA} Starting Batch FFmpeg Encoding Queue   ${C_RESET}"
echo -e "${C_MAGENTA}========================================${C_RESET}"

total_files=${#files[@]}
current=1

for file in "${files[@]}"; do
    [[ ! -f "$file" ]] && continue
    
    filename=$(basename -- "$file")
    basename_no_ext="${filename%.*}"
    output_file="${basename_no_ext}.$container"

    # Safely handle name collisions so we never overwrite existing files
    if [[ "$file" == "$output_file" || -e "$output_file" ]]; then
        counter=1
        while [[ -e "${basename_no_ext}_${counter}.$container" ]]; do
            ((counter++))
        done
        output_file="${basename_no_ext}_${counter}.$container"
        echo -e "${C_YELLOW}Notice: Target exists. Renaming output to:${C_RESET} ${C_CYAN}$output_file${C_RESET}"
    fi

    echo -e "\n${C_YELLOW}[${current}/${total_files}] Processing:${C_RESET} ${C_CYAN}$filename${C_RESET} -> ${C_GREEN}$output_file${C_RESET}"
    
    ffmpeg -i "$file" $vcodec_args $video_filter_arg $acodec_args $sample_rate_arg $channel_arg $subtitle_arg $extra_movflags "$output_file"
    
    ((current++))
done

echo -e "${C_GREEN}✔ Batch processing complete!${C_RESET}\n"
