#!/usr/bin/env bash

clear

# Split $PATH by colon safely
IFS=':' read -ra PATH_DIRS <<< "$PATH"

# Gather all unique binaries and their full paths
selected=$(
    find "${PATH_DIRS[@]}" -maxdepth 1 -type f -executable 2>/dev/null | \
    while read -r file; do
        printf "%s\t%s\n" "$(basename "$file")" "$file"
    done | sort -u -k1,1 | \
    fzf --prompt="Run Binary > " \
        --delimiter="\t" \
        --with-nth=1 \
        --ansi \
        --bind "home:first,end:last" \
        --preview-window=right:60%:wrap \
        --preview '
            bin={1}
            path={2}
            
            # ANSI Colors
            cyan="\033[1;36m"
            green="\033[1;32m"
            yellow="\033[1;33m"
            blue="\033[1;34m"
            gray="\033[0;90m"
            reset="\033[0m"

            echo -e "${cyan}==========================================${reset}"
            echo -e "${green}EXECUTABLE:${reset} ${yellow}$bin${reset}"
            echo -e "${green}PATH:      ${reset} ${gray}$path${reset}"
            echo -e "${cyan}==========================================${reset}"
            echo ""

            # 1. Try Man Page first
            if man -w "$bin" &>/dev/null; then
                echo -e "${blue}── MAN PAGE EXCERPT ──${reset}"
                man "$bin" 2>/dev/null | col -bx | head -n 30
            # 2. Fall back to Pacman info if no man page exists
            else
                echo -e "${blue}── PACMAN PACKAGE INFO (FALLBACK) ──${reset}"
                pkg=$(pacman -Qqo "$path" 2>/dev/null)
                if [[ -n "$pkg" ]]; then
                    pacman -Qi "$pkg" 2>/dev/null | grep -E "^(Name|Version|Description)"
                else
                    echo -e "${gray}Locally compiled / Not from official repos/AUR (No man page available)${reset}"
                fi
            fi
        '
)

# Extract the actual file path (second column) and run it only on Enter
if [[ -n "$selected" ]]; then
    bin_path=$(echo "$selected" | awk -F'\t' '{print $2}')
    nohup "$bin_path" >/dev/null 2>&1 &
fi
