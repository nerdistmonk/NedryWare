#!/usr/bin/env bash

# Ensure required commands are available
for cmd in fzf pacman awk sort; do
    if ! command -v "$cmd" &>/dev/null; then
        echo "Error: Required command '$cmd' is not installed." >&2
        exit 1
    fi
done

# Function to generate installed packages list sorted by size
get_installed_pkg_list() {
    LC_ALL=C pacman -Qi | awk '
        /^Name[[:space:]]*:/ {name=$3}
        /^Installed Size[[:space:]]*:/ {
            val=$4; unit=$5;
            mult=1;
            if (unit == "KiB") mult=1024;
            else if (unit == "MiB") mult=1024*1024;
            else if (unit == "GiB") mult=1024*1024*1024;
            bytes = val * mult;
            printf "%.0f %s %s\n", bytes, val " " unit, name;
        }
    ' | sort -nr | awk '{print $2, $3, $4}'
}

# Function to generate available repo packages list (excluding installed)
get_available_pkg_list() {
    LC_ALL=C pacman -Sl | awk '!/\[installed\]/ {print $1, $2, $3}'
}

echo "Analyzing installed packages..." >&2
current_mode="installed"
pkg_list=$(get_installed_pkg_list)

if [ -z "$pkg_list" ]; then
    echo "No packages found or error reading pacman database." >&2
    exit 1
fi

# Main loop
while true; do
    if [ "$current_mode" = "installed" ]; then
        header_text="📦 Installed | ENTER: Details | ^d: Remove | ^u: Update | ^c: Clean | ^i: Repo Mode | ^f: AUR | ^o: Orphans | ESC: Exit"
        preview_cmd='
            pkg={3}
            echo -e "\033[1;36m╔════════════════════════════════════════╗\033[0m"
            echo -e "\033[1;36m║           PACKAGE INSPECTOR            ║\033[0m"
            echo -e "\033[1;36m╚════════════════════════════════════════╝\033[0m"
            echo -e "\033[1;33mName:\033[0m $pkg"
            echo ""
            LC_ALL=C pacman -Qi "$pkg" | grep -E "Version|Description|Installed Size|Install Date|Install Reason|Required By" \
                | sed "s/^/  • /"
        '
        expect_keys="ctrl-d,ctrl-u,ctrl-c,ctrl-f,ctrl-o,ctrl-i"
    else
        header_text="🌐 Available Repo (Uninstalled) | ENTER: Install (-S) | ^i: Back to Installed | ESC: Exit"
        preview_cmd='
            pkg={2}
            echo -e "\033[1;35m╔════════════════════════════════════════╗\033[0m"
            echo -e "\033[1;35m║          REPO PACKAGE DETAILS          ║\033[0m"
            echo -e "\033[1;35m╚════════════════════════════════════════╝\033[0m"
            echo -e "\033[1;33mRepository / Name:\033[0m {1} / $pkg"
            echo ""
            LC_ALL=C pacman -Si "$pkg" 2>/dev/null | grep -E "Repository|Name|Version|Description|Architecture|URL|Groups|Licenses" \
                | sed "s/^/  • /"
        '
        expect_keys="ctrl-i"
    fi

    output=$(echo "$pkg_list" | fzf \
        --ansi \
        --expect="$expect_keys" \
        --header="$header_text" \
        --prompt="Search Package > " \
        --layout=reverse \
        --border=rounded \
        --height=95% \
        --color="header:italic:cyan,prompt:green,pointer:yellow,marker:red" \
        --preview-window=right:55%:wrap \
        --preview "$preview_cmd"
    )

    [ -z "$output" ] && exit 0

    key=$(echo "$output" | head -n 1)
    selected=$(echo "$output" | tail -n +2)

    if [ "$key" = "ctrl-i" ]; then
        clear
        if [ "$current_mode" = "installed" ]; then
            echo "Loading uninstalled repository packages (this may take a moment)..."
            current_mode="available"
            pkg_list=$(get_available_pkg_list)
        else
            echo "Loading installed packages..."
            current_mode="installed"
            pkg_list=$(get_installed_pkg_list)
        fi
        continue
    fi

    if [ "$current_mode" = "available" ]; then
        pkg_name=$(echo "$selected" | awk '{print $2}')
        if [ -n "$pkg_name" ]; then
            clear
            echo -e "\033[1;32m==================================================\033[0m"
            echo -e "\033[1;32m Installing Package: $pkg_name (pacman -S)\033[0m"
            echo -e "\033[1;32m==================================================\033[0m"
            sudo pacman -S "$pkg_name"
            echo -e "\033[1;33m==================================================\033[0m"
            read -rp "Action complete. Press [Enter] to return..."
        fi
        continue
    fi

    pkg_name=$(echo "$selected" | awk '{print $3}')
    clear

    case "$key" in
        ctrl-d)
            if [ -n "$pkg_name" ]; then
                echo -e "\033[1;31m==================================================\033[0m"
                echo -e "\033[1;31m Removing Package: $pkg_name (pacman -Rs)\033[0m"
                echo -e "\033[1;31m==================================================\033[0m"
                sudo pacman -Rs "$pkg_name"
                echo -e "\033[1;33m==================================================\033[0m"
                read -rp "Action complete. Press [Enter] to return..."
            fi
            ;;
        ctrl-u)
            echo -e "\033[1;34m==================================================\033[0m"
            echo -e "\033[1;34m Running System Update (sudo pacman -Syyu)\033[0m"
            echo -e "\033[1;34m==================================================\033[0m"
            sudo pacman -Syyu
            echo -e "\033[1;33m==================================================\033[0m"
            read -rp "Update complete. Press [Enter] to return..."
            ;;
        ctrl-c)
            # Differentiate between normal ctrl-c (clean cache -Sc) vs ctrl-shift-c if possible, 
            # or map ctrl-c to -Sc. Let's use ctrl-c for -Sc.
            echo -e "\033[1;33m==================================================\033[0m"
            echo -e "\033[1;33m Cleaning Package Cache (sudo pacman -Sc)\033[0m"
            echo -e "\033[1;33m==================================================\033[0m"
            sudo pacman -Sc
            echo -e "\033[1;33m==================================================\033[0m"
            read -rp "Cache clean complete. Press [Enter] to return..."
            ;;
        ctrl-f)
            echo -e "\033[1;35m==================================================\033[0m"
            echo -e "\033[1;35m Foreign / AUR Packages (pacman -Qm)\033[0m"
            echo -e "\033[1;35m==================================================\033[0m"
            foreign_pkgs=$(LC_ALL=C pacman -Qm)
            if [ -z "$foreign_pkgs" ]; then
                echo "No foreign/AUR packages found."
            else
                echo "$foreign_pkgs"
                echo -e "\033[1;35m==================================================\033[0m"
                read -rp "Do you wish to remove these foreign packages? [y/N]: " confirm
                if [[ "$confirm" =~ ^[Yy]$ ]]; then
                    foreign_names=$(LC_ALL=C pacman -Qm -q)
                    sudo pacman -Rns $foreign_names
                fi
            fi
            echo -e "\033[1;33m==================================================\033[0m"
            read -rp "Action complete. Press [Enter] to return..."
            ;;
        ctrl-o)
            echo -e "\033[1;35m==================================================\033[0m"
            echo -e "\033[1;35m Orphaned Packages (pacman -Qdt)\033[0m"
            echo -e "\033[1;35m==================================================\033[0m"
            orphan_pkgs=$(LC_ALL=C pacman -Qdt)
            if [ -z "$orphan_pkgs" ]; then
                echo "No orphaned packages found."
            else
                echo "$orphan_pkgs"
                echo -e "\033[1;35m==================================================\033[0m"
                read -rp "Do you wish to remove these orphaned packages? [y/N]: " confirm
                if [[ "$confirm" =~ ^[Yy]$ ]]; then
                    orphan_names=$(LC_ALL=C pacman -Qdtq)
                    sudo pacman -Rns $orphan_names
                fi
            fi
            echo -e "\033[1;33m==================================================\033[0m"
            read -rp "Action complete. Press [Enter] to return..."
            ;;
        *)
            if [ -n "$pkg_name" ]; then
                echo -e "\033[1;32m==================================================\033[0m"
                echo -e "\033[1;32m Full Details for: $pkg_name\033[0m"
                echo -e "\033[1;32m==================================================\033[0m"
                LC_ALL=C pacman -Qi "$pkg_name"
                echo -e "\033[1;32m==================================================\033[0m"
                echo ""
                read -rp "Press [Enter] to return to the package list..."
            fi
            ;;
    esac

    pkg_list=$(get_installed_pkg_list)
    clear
done
